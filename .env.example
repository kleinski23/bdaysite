# Wishes are stored in a Vercel Blob store. Connecting the store to the Vercel project sets BLOB_READ_WRITE_TOKEN there.
# To use that store locally (dev server or `npm run wishes`), run `npx vercel env pull .env.local`.
# Without a token, local development saves wishes to data/wishes.json instead.
BLOB_READ_WRITE_TOKEN=
# Must match the store's access type chosen when it was created: private (recommended) or public.
BLOB_ACCESS=private
